# =============================================================================
# IT Support Ticket Management System - Environment Template (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# - This file is a TEMPLATE ONLY containing safe placeholder values.
# - NEVER commit real passwords, credentials, or production secrets to Git.
# - Copy this file to '.env' (which is git-ignored) for local development:
#     cp .env.example .env
# =============================================================================

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ticket_system_db
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# JWT Security Configuration
# - WARNING: The JWT_SECRET below is an EXAMPLE PLACEHOLDER for local wiring only.
#   NEVER use this example value in any real, staging, or production environment!
# - Requirement: HS256 requires a secret of at least 256 bits (32 bytes).
# - Decoding: The JWT service will decode this key using Base64 (Decoders.BASE64.decode).
# - To generate your own secure 256-bit Base64 secret locally, run:
#     openssl rand -base64 32
#   or in PowerShell:
#     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
